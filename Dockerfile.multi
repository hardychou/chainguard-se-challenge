FROM golang:1.18 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /hello-server .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /hello-server /hello-server
USER nonroot
EXPOSE 8080
ENTRYPOINT ["/hello-server"]
